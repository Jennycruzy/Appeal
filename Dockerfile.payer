FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

COPY src ./src
COPY scripts/run_payer_service.py ./scripts/run_payer_service.py

RUN useradd --create-home --uid 10001 payer \
    && chown -R payer:payer /app

USER payer

CMD ["python", "scripts/run_payer_service.py"]
